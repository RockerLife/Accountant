			<formlinkforward eval="AccountantRule.isAlreadyRenewedAndStatusNewUnderReview"  component="RenewBasicInfo" action="view" seq="1" name="insuredRenewedByMail"></formlinkforward>			
			-->
			<formlinkforward eval="AccountantRule.isNotAlreadyRenewedNewAppFlow"  component="FirmNewApp" action="view" seq="0" name="insuredRenewedByMail"></formlinkforward>
			<formlinkforward eval="AccountantRule.isNotAlreadyRenewedOldAppFlow"  component="RenewBasicInfo" action="view" seq="1" name="insuredRenewedByMail"></formlinkforward>			
			<formlinkforward eval="AccountantRule.isAlreadyRenewed"  component="renewThanks" action="view" seq="4" name="insuredRenewedByMail"></formlinkforward>
		</formlink>
	</pagecomponent>

