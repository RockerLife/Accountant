<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.1"
	xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
	xmlns:fo="http://www.w3.org/1999/XSL/Format"
	exclude-result-prefixes="fo"
	xmlns:fn="http://www.w3.org/2005/02/xpath-functions"
	xmlns:java="java">

	<xsl:template match="/" name="AAA04F035" >
	
		    
		<fo:block>
			<xsl:call-template name="CommonHeader"/>
		</fo:block>
		<fo:block margin-top="12mm"/>
		<fo:block text-align="center" font-weight="bold" font-size="10px">PENNSYLVANIA AMENDATORY ENDORSEMENT</fo:block>
		<fo:block margin-top="4mm"/>
		<fo:block padding-left="5pt" font-family="Arial, 'Helvetica Neue', Helvetica, sans-serif;" font-size="10px" text-align="justify">
			<fo:block space-after="4mm">
				In consideration of the premium charged, it is agreed that:
			</fo:block>
			<fo:block space-after="4mm">
				<fo:list-block>
					<fo:list-item>
						<fo:list-item-label>
							<fo:block>1.</fo:block>
						</fo:list-item-label>
						<fo:list-item-body start-indent="7mm">
							<fo:block space-after="4mm">Section VI., General Condition D., Cancellation and Nonrenewal, is deleted and replaced with the following:</fo:block>
							<fo:block>
								<fo:list-block>
									<fo:list-item space-after="4mm">
										<fo:list-item-label>
											<fo:block font-weight="bold">D.</fo:block>
										</fo:list-item-label>
										<fo:list-item-body start-indent="14mm">
											<fo:block font-weight="bold" space-after="4mm">
												Cancellation, Nonrenewal, Loss Information and Premium Increase
											</fo:block>
											<fo:block>
												<fo:list-block>
													<fo:list-item space-after="4mm">
														<fo:list-item-label>
															<fo:block font-weight="bold">1.</fo:block>
														</fo:list-item-label>
														<fo:list-item-body start-indent="21mm">
															<fo:block font-weight="bold" space-after="4mm">
																Cancellation
															</fo:block>
															<fo:block>
																<fo:list-block>
																	<fo:list-item space-after="4mm">
																		<fo:list-item-label>
																			<fo:block>(a)</fo:block>
																		</fo:list-item-label>
																		<fo:list-item-body start-indent="28mm">
																			<fo:block>
																				The <fo:inline font-weight="bold">Named Insured</fo:inline> may cancel this policy at any time prior to the expiration date of the <fo:inline font-weight="bold">Policy Period</fo:inline> by providing prior written notice to the <fo:inline font-weight="bold">Insurer</fo:inline> or by surrender of this policy to the <fo:inline font-weight="bold">Insurer</fo:inline> or its authorized agent. If the <fo:inline font-weight="bold">Named Insured</fo:inline> cancels this policy, the <fo:inline font-weight="bold">Insurer</fo:inline>
																				shall return 90% of the unearned portion of the premium within 30 days after the effective date of cancellation.
																			</fo:block>
																		</fo:list-item-body>
																	</fo:list-item>
																	<fo:list-item space-after="4mm">
																		<fo:list-item-label>
																			<fo:block>(b)</fo:block>
																		</fo:list-item-label>
																		<fo:list-item-body start-indent="28mm">
																			<fo:block>
																				The <fo:inline font-weight="bold">Insurer</fo:inline> may only cancel this policy for nonpayment of premium or Deductible.  This policy may be canceled by the <fo:inline font-weight="bold">Insurer</fo:inline> by mailing or delivering to the <fo:inline font-weight="bold">Named Insured</fo:inline>, at the address shown in Item 1. of the Declarations, written notice of cancellation at least 15 days before the effective date of cancellation.  Such notice shall state the specific reasons for cancellation.  If mailed, the notice shall be forwarded by registered or first class mail.  The mailing of such notice shall be sufficient proof of notice and the effective date of cancellation stated in such notice shall become the expiration date of the <fo:inline font-weight="bold">Policy Period</fo:inline>.  If the <fo:inline font-weight="bold">Insurer</fo:inline> cancels this policy, the <fo:inline font-weight="bold">Insurer</fo:inline> shall credit the <fo:inline font-weight="bold">Named Insured</fo:inline> the pro rata unearned portion of the premium.  Payment or tender of any unearned premium by the <fo:inline font-weight="bold">Insurer</fo:inline> shall not be a condition precedent to the effectiveness of cancellation, but such payment shall be made within 10 business days after the effective date of cancellation.
																			</fo:block>
																		</fo:list-item-body>
																	</fo:list-item>
																</fo:list-block>
															</fo:block>
														</fo:list-item-body>
													</fo:list-item>
												</fo:list-block>
											</fo:block>
										</fo:list-item-body>
									</fo:list-item>
								</fo:list-block>
							</fo:block>
						</fo:list-item-body>
					</fo:list-item>
				</fo:list-block>
			</fo:block>
			<fo:block space-after="3mm">
				<fo:list-block>
					<fo:list-item>
						<fo:list-item-label>
							<fo:block font-weight="bold" start-indent="14mm">
								2.
							</fo:block>
						</fo:list-item-label>
						<fo:list-item-body start-indent="21mm">
							<fo:block font-weight="bold">
								Nonrenewal
							</fo:block>
						</fo:list-item-body>
					</fo:list-item>
				</fo:list-block>
			</fo:block>
			<fo:block start-indent="21mm" space-after="4mm">
				This policy may be nonrenewed by the <fo:inline font-weight="bold">Insurer</fo:inline> by mailing or delivering to the <fo:inline font-weight="bold">Named Insured</fo:inline>, at the address shown in Item 1. of the Declarations, written notice of nonrenewal at least 60 days prior to the expiration date of the <fo:inline font-weight="bold">Policy Period</fo:inline>.  Such notice shall state the specific reasons for nonrenewal.  If mailed, the notice shall be forwarded by registered or first class mail.  The mailing of such notice shall be sufficient proof of notice.  Until the <fo:inline font-weight="bold">Insurer</fo:inline> issues a nonrenewal notice that complies with the provisions of this subsection, coverage will remain in effect.  However, if the <fo:inline font-weight="bold">Named Insured</fo:inline> obtains replacement coverage, the <fo:inline font-weight="bold">Insurer’s</fo:inline> obligation to continue coverage ceases.
			</fo:block>
			<fo:block margin-top="8cm"/>
			<fo:block font-size="10px" color="grey" text-align="left">ISMIE AAA-04-F035 (04012022)
		       	 <fo:block margin-top="-0.5cm" font-size="10px" color="grey" text-align="right">Page 1 of 2</fo:block>
			</fo:block>
		</fo:block>
		<fo:block break-after="page"/>
			
		<fo:block padding-left="5pt" font-family="Arial, 'Helvetica Neue', Helvetica, sans-serif;" font-size="10px" text-align="justify">
			<fo:list-block space-after="8mm">
				<fo:list-item space-after="4mm">
					<fo:list-item-label start-indent="14mm">
						<fo:block font-weight="bold">3.</fo:block>
					</fo:list-item-label>
					<fo:list-item-body start-indent="21mm">
						<fo:block font-weight="bold" space-after="4mm">
							Loss Information
						</fo:block>
						<fo:block space-after="4mm">
							A notice of cancellation or nonrenewal shall state that, at the <fo:inline font-weight="bold">Named Insured’s</fo:inline> request, the <fo:inline font-weight="bold">Insurer</fo:inline> shall provide loss information to the <fo:inline font-weight="bold">Named Insured</fo:inline> for at least three years or the period of time during which the <fo:inline font-weight="bold">Insurer</fo:inline> has provided coverage to the <fo:inline font-weight="bold">Named Insured</fo:inline>, whichever is less.  Loss information shall consist of the following:
						</fo:block>
						<fo:block>
							<fo:list-block>
								<fo:list-item space-after="4mm">
									<fo:list-item-label>
										<fo:block>(a)</fo:block>
									</fo:list-item-label>
									<fo:list-item-body start-indent="28mm">
										<fo:block>
											information on closed <fo:inline font-weight="bold">Claims</fo:inline>, including date and description of occurrence, and amount of payments, if any;
										</fo:block>
									</fo:list-item-body>
								</fo:list-item>
								<fo:list-item space-after="4mm">
									<fo:list-item-label>
										<fo:block>(b)</fo:block>
									</fo:list-item-label>
									<fo:list-item-body start-indent="28mm">
										<fo:block>
											information on open <fo:inline font-weight="bold">Claims</fo:inline>, including date and description of occurrence, amount of payment, if any, and amount of reserves, if any; and
										</fo:block>
									</fo:list-item-body>
								</fo:list-item>
								<fo:list-item space-after="4mm">
									<fo:list-item-label>
										<fo:block>(c)</fo:block>
									</fo:list-item-label>
									<fo:list-item-body start-indent="28mm">
										<fo:block>
											information on notices of occurrence, including date and description of occurrence and amount of reserves, if any.  The <fo:inline font-weight="bold">Named Insured’s</fo:inline> written request for loss information must be made within 10 days of its receipt of the cancellation or nonrenewal notice.  The <fo:inline font-weight="bold">Insurer</fo:inline> shall have 30 days from the date of the <fo:inline font-weight="bold">Named Insured’s</fo:inline> written request to provide the requested information.
										</fo:block>
									</fo:list-item-body>
								</fo:list-item>
							</fo:list-block>
						</fo:block>
					</fo:list-item-body>
				</fo:list-item>
				<fo:list-item space-after="4mm">
					<fo:list-item-label start-indent="14mm">
						<fo:block font-weight="bold">4.</fo:block>
					</fo:list-item-label>
					<fo:list-item-body start-indent="21mm">
						<fo:block font-weight="bold" space-after="4mm">
							Premium Increase
						</fo:block>
						<fo:block space-after="4mm">
							The <fo:inline font-weight="bold">Insurer</fo:inline> or its authorized agent shall provide the <fo:inline font-weight="bold">Named Insured</fo:inline> advance notice of any increase in renewal premium at least 30 days prior to the expiration of the <fo:inline font-weight="bold">Policy Period</fo:inline>.  The <fo:inline font-weight="bold">Insurer</fo:inline> is responsible for documenting that advance notice was provided to the <fo:inline font-weight="bold">Named Insured</fo:inline>.  The <fo:inline font-weight="bold">Insurer</fo:inline> may satisfy this requirement by doing one of the following:
						</fo:block>
						<fo:block>
							<fo:list-block>
								<fo:list-item space-after="4mm">
									<fo:list-item-label>
										<fo:block>(a)</fo:block>
									</fo:list-item-label>
									<fo:list-item-body start-indent="28mm">
										<fo:block>
											maintaining a copy of the advance written notice provided to the <fo:inline font-weight="bold">Named Insured</fo:inline>;
										</fo:block>
									</fo:list-item-body>
								</fo:list-item>
								<fo:list-item space-after="4mm">
									<fo:list-item-label>
										<fo:block>(b)</fo:block>
									</fo:list-item-label>
									<fo:list-item-body start-indent="28mm">
										<fo:block>
											documenting its file to reflect the date and time advance notice was provided to the <fo:inline font-weight="bold">Named Insured</fo:inline>;
										</fo:block>
									</fo:list-item-body>
								</fo:list-item>
								<fo:list-item space-after="4mm">
									<fo:list-item-label>
										<fo:block>(c)</fo:block>
									</fo:list-item-label>
									<fo:list-item-body start-indent="28mm">
										<fo:block>
											providing documentation from its agent reflecting compliance with either paragraph (a) or (b); or
										</fo:block>
									</fo:list-item-body>
								</fo:list-item>
								<fo:list-item space-after="4mm">
									<fo:list-item-label>
										<fo:block>(d)</fo:block>
									</fo:list-item-label>
									<fo:list-item-body start-indent="28mm">
										<fo:block>
											providing other documentation such as renewal offers or other methods which are accepted and common within the industry as would reasonably demonstrate compliance.
										</fo:block>
									</fo:list-item-body>
								</fo:list-item>
							</fo:list-block>
						</fo:block>
					</fo:list-item-body>
				</fo:list-item>
			</fo:list-block>
			<fo:block>
				All other terms, conditions and limitations of the policy remain unaltered.
			</fo:block>
			<fo:block margin-top="12cm"/>
			<fo:block font-size="10px" color="grey" text-align="left">ISMIE AAA-04-F035 (04012022)
		       	 <fo:block margin-top="-0.5cm" font-size="10px" color="grey" text-align="right">Page 2 of 2</fo:block>
			</fo:block>
		</fo:block>
		<fo:block page-break-before="auto"/>
		  
     </xsl:template>
</xsl:stylesheet>
